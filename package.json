{
  "name": "kraftly-mina-sidor",
  "version": "0.9.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node mock-api/server.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e:cy": "start-server-and-test \"npm run api\" http://localhost:4000/healthz \"npm run dev\" http://localhost:5173 \"cypress run\"",
    "e2e:ci": "start-server-and-test \"npm run api\" http://localhost:4000/healthz \"npm run preview -- --port 5173\" http://localhost:5173 \"cypress run\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "vitest run a11y",
    "co2": "node scripts/co2.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "express": "^4.21.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^0.1.7",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/vue": "^8.1.0",
    "@tgwf/co2": "^0.19.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.5",
    "cypress": "^15.21.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true,
    "cypress@15.21.1": true
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix"
    ],
    "*.{js,vue,json,css,md}": [
      "prettier --write"
    ]
  }
}
